# Copy this file to .streamlit/secrets.toml (already gitignored -- never commit
# the real file) and fill in your own key. Get a free Gemini key at
# https://aistudio.google.com/apikey
#
# When deploying on Streamlit Community Cloud, don't upload this file at all --
# set the same key/value in the app's Settings -> Secrets panel instead.

GEMINI_API_KEY = "your_gemini_api_key_here"
